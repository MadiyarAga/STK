# Секретный ключ подписи. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# База данных
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Redis: кэш и брокер Celery. Снаружи — redis://localhost:6379/0
REDIS_URL=

# Уровень логирования: DEBUG / INFO / WARNING / ERROR. По умолчанию INFO
LOG_LEVEL=

# Только для prod: список хостов через запятую
DJANGO_ALLOWED_HOSTS=